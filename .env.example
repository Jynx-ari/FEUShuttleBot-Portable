# User Credentials
USER_EMAIL=your_email@example.com
USER_PASSWORD=your_password
FEUA_SESSION_COOKIE=your_session_cookie_here

# Notification Webhooks
MSTEAMSWEBHOOK_URL=https://outlook.office.com/webhook/...
DISCORDWEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_ENABLED=true
DISCORD_PING=true
DISCORD_ROLE_ID=1234567891011121314 #example
TEAMS_ENABLED=true

# Browser / Puppeteer settings
# On Linux, RPi, or non-standard installs, set CHROME_PATH or PUPPETEER_EXECUTABLE_PATH
CHROME_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=
CHROME_EXECUTABLE_PATH=
BROWSER_PATH=

# Bot Settings
MODE=production
DEBUG=false
HEADLESS=true
MEMORY_LIMIT_MB=300



MODE=normal
HEADLESS=true
